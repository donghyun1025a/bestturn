# 텔레그램 봇 토큰 (@BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=

# 공공데이터포털 일반 인증키 (Decoding 키 권장)
DATA_GO_KR_SERVICE_KEY=

# 접근 허용 텔레그램 사용자 ID (쉼표 구분). 비워두면 전체 허용(운영 시 반드시 설정 권장)
ALLOWED_USER_IDS=

# 선택 설정
IIA_DB_PATH=data/bookings.db
IIA_CONFIG_DIR=config
# 항공편 API 일일 호출 한도(운항현황 오퍼레이션당 500), 혼잡도 1000
IIA_FLIGHT_DAILY_BUDGET=450
IIA_CONGESTION_DAILY_BUDGET=900
LOG_LEVEL=INFO
