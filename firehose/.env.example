# FlightAware Firehose 계정 (체험 계정 메일로 발급)
FIREHOSE_USERNAME=
FIREHOSE_PASSWORD=
FIREHOSE_HOST=firehose.flightaware.com
FIREHOSE_PORT=1501

# 수집 대상 — 항공사 코드(쉼표 구분)와 도착 공항
ETA_AIRLINES=WE,8M,AS,AA,WS
ETA_AIRPORT=ICN

# 저장소 및 조회 API
ETA_DB_PATH=data/eta.db
ETA_API_HOST=127.0.0.1
ETA_API_PORT=8800
LOG_LEVEL=INFO
