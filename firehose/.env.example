# 이 파일을 .env 로 복사해서 쓰세요. 대부분은 화면에서 입력하면 되고,
# 아래 항목들은 화면에 없는 예외적인 설정입니다.

# 사내 방화벽이 TLS 를 가로채는 환경에서, 신뢰할 사내 루트 CA 파일 경로.
# `python run.py doctor` 가 필요하다고 안내할 때만 넣으세요.
# 예) FIREHOSE_CA_BUNDLE=C:\certs\company-root-ca.pem
FIREHOSE_CA_BUNDLE=

# UI 없이 수집만 돌릴 때(python run.py ingest) 쓰는 자격증명.
# 화면에서 저장했다면 비워 두세요.
FIREHOSE_USERNAME=
FIREHOSE_PASSWORD=

# 대시보드 바인딩. 인증이 없으므로 127.0.0.1 을 벗어나지 마세요.
ETA_API_HOST=127.0.0.1
ETA_API_PORT=8800

ETA_DB_PATH=data/eta.db
LOG_LEVEL=INFO
